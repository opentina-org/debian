# SPDX-License-Identifier: MIT
# OpenTina Debian lite rootfs, cross-arch build via BuildKit/QEMU.
# Builds the same package set as mk-lite-rootfs.sh, but as a Dockerfile so
# that `docker buildx build --platform linux/arm64 -o type=tar` can produce
# a rootfs tar without debootstrap, host binfmt registration, or a privileged
# container.

ARG SUITE=trixie
FROM debian:${SUITE}${BASE_FLAVOR}

ARG SUITE=trixie
ARG BASE_FLAVOR=-slim
ARG DEBIAN_MIRROR=http://deb.debian.org/debian
ARG DEBIAN_SECURITY_MIRROR=http://security.debian.org/debian-security
ARG ROOT_PASSWORD=root
ARG EXTRA_DEBS=""
ARG SERIAL_TTY=ttyS0
ARG HOSTNAME=debian-lite
ARG DESKTOP=0
ARG SERIAL_FIX=0

ENV DEBIAN_FRONTEND=noninteractive

# 1. APT sources, full-upgrade, lite packages.
RUN set -eux; \
    # trixie-slim ships /etc/apt/sources.list.d/debian.sources (deb822); remove
    # it so our /etc/apt/sources.list is the only source list and apt-get
    # doesn't complain "Target Packages ... is configured multiple times".
    rm -f /etc/apt/sources.list.d/debian.sources; \
    case "${SUITE}" in \
    bookworm) \
        printf '%s\n' \
            "deb ${DEBIAN_MIRROR}/ bookworm main contrib non-free non-free-firmware" \
            "deb ${DEBIAN_MIRROR}/ bookworm-updates main contrib non-free non-free-firmware" \
            "deb ${DEBIAN_SECURITY_MIRROR}/ bookworm-security main contrib non-free non-free-firmware" \
            > /etc/apt/sources.list; \
        ;; \
    *) \
        printf '%s\n' \
            "deb ${DEBIAN_MIRROR}/ trixie main contrib non-free non-free-firmware" \
            "deb ${DEBIAN_MIRROR}/ trixie-updates main contrib non-free non-free-firmware" \
            "deb ${DEBIAN_SECURITY_MIRROR}/ trixie-security main contrib non-free non-free-firmware" \
            > /etc/apt/sources.list; \
        ;; \
    esac; \
    apt-get -y update; \
    apt-get -y full-upgrade; \
    apt-get -y install --no-install-recommends \
        openssh-server sudo locales ca-certificates curl wget \
        iproute2 iputils-ping ifupdown isc-dhcp-client \
        vim-tiny less file pciutils usbutils kmod dbus \
        systemd-sysv systemd-timesyncd udev ${EXTRA_DEBS}; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*

# 1b. Optional desktop/HMI stack (DESKTOP=1): software-rendered Wayland/Weston.
RUN set -eux; \
    if [ "${DESKTOP}" = "1" ]; then \
        apt-get -y update; \
        apt-get -y install --no-install-recommends \
            weston seatd xwayland \
            libgl1-mesa-dri mesa-utils \
            gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
            gstreamer1.0-plugins-bad gstreamer1.0-libav \
            gstreamer1.0-alsa gstreamer1.0-pulseaudio gstreamer1.0-gl \
            pulseaudio alsa-utils \
            chromium \
            fonts-dejavu-core dbus-user-session; \
        printf '%s\n' 'LIBGL_ALWAYS_SOFTWARE=1' 'GALLIUM_DRIVER=llvmpipe' \
            >> /etc/environment; \
        apt-get clean; \
        rm -rf /var/lib/apt/lists/*; \
    fi

# 2. /sbin/init fallback, locale, root password, hostname, hosts.
RUN set -eux; \
    if [ ! -e /sbin/init ] && [ ! -e /usr/sbin/init ]; then \
        ln -sf /lib/systemd/systemd /usr/sbin/init; \
    fi; \
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen; \
    locale-gen; \
    update-locale LANG=en_US.UTF-8; \
    echo "root:${ROOT_PASSWORD}" | chpasswd; \
    echo "${HOSTNAME}" > /etc/hostname
# Note: /etc/hosts is read-only during buildx (BuildKit mounts it). The 127.0.1.1
# entry from mk-lite-rootfs.sh is dropped here; systemd-hostnamed / cloud-init
# populate it at first boot if needed.

# 3. /etc/fstab + systemd manager drop-in (no /boot auto-mount, generous timeout).
RUN set -eux; \
    mkdir -p /etc/systemd/system.conf.d; \
    printf '%s\n%s\n' '[Manager]' 'DefaultTimeoutStartSec=120s' \
        > /etc/systemd/system.conf.d/opentina.conf; \
    cat > /etc/fstab <<'FSTAB'
# <file system> <mount point>   <type>  <options>       <dump>  <pass>
proc            /proc           proc    defaults          0       0
sysfs           /sys            sysfs   defaults          0       0
tmpfs           /tmp            tmpfs   defaults,nodev,nosuid  0  0
FSTAB

# 4. Default target, mask noisy services, enable sshd.
RUN set -eux; \
    systemctl set-default multi-user.target; \
    systemctl mask rsyslog.service 2>/dev/null || true; \
    systemctl enable ssh

# 5. Project overlay (opentina-serial-getty@.service, etc).
COPY overlay/ /

# 6. Optional serial workaround. Normal profiles use the standard systemd
# serial-getty now that udev is installed; SERIAL_FIX=1 is retained only for
# regression testing images that must bypass the tty device unit.
RUN set -eux; \
    if [ "${SERIAL_FIX}" = "1" ]; then \
        systemctl mask "serial-getty@${SERIAL_TTY}.service"; \
        systemctl enable "opentina-serial-getty@${SERIAL_TTY}.service" 2>/dev/null || true; \
    fi

# 7. OEM injection. Customer assets are staged into .oem-staging/ by the buildx
#    wrapper (empty = no-op). Unmet deps abort the build; no `apt -f install`.
COPY .oem-staging/ /oem/
RUN set -eux; \
    if ls /oem/packages/*.deb >/dev/null 2>&1; then \
        apt-get -y update; \
        apt-get -y install --no-install-recommends /oem/packages/*.deb; \
        apt-get clean; \
        rm -rf /var/lib/apt/lists/*; \
    fi; \
    if [ -d /oem/rootfs-overlay ]; then \
        cp -a /oem/rootfs-overlay/. /; \
    fi; \
    if [ -x /oem/post.sh ]; then \
        /oem/post.sh; \
    fi; \
    rm -rf /oem

# Marker for downstream "what's this rootfs" queries.
RUN printf 'OPENTINA_REVISION=Dockerfile.rootfs\nSUITE=%s\nPROFILE=%s\nBASE_FLAVOR=%s\n' \
        "${SUITE}" "$([ "${DESKTOP}" = "1" ] && echo desktop || echo lite)" \
        "${BASE_FLAVOR}" \
        > /etc/opentina-rootfs-release
